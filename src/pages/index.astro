---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TopThree from '../components/TopThree.astro';
import Weather from '../components/Weather.astro';
import { cover, areaTextColor, issueNumbers, uniqueAreas, withBase } from '../lib/theme';
import { parsePlan } from '../lib/plan';

const all = await getCollection('issues');
const numbers = issueNumbers(all.map((i) => i.id));
// Newest first — highest derived issue number on top.
const issues = [...all].sort((a, b) => numbers.get(b.id)! - numbers.get(a.id)!);
const latest = issues[0];
const archive = issues.slice(1);

const latestNo = latest ? numbers.get(latest.id)! : 0;
const latestCover = latest ? cover(latest.data.cover) : null;
const latestHref = latest ? withBase(`issues/${latest.id}/`) : withBase('/');

// The plan body is parsed so the home page can show the top-three shortlist.
const plan = latest ? parsePlan(latest.body) : null;
const topNotes = plan?.ok ? plan.topNotes : [];
const picks = latest?.data.picks ?? [];
const areas = uniqueAreas(picks);

function stopCount(count: number) {
  return count === 1 ? '1 stop' : `${count} stops`;
}
---
<Base title="Our Weekend Plans">
  <SiteHeader variant="home" />
  <main class="home">
    {!latest ? (
      <div class="empty">
        <p class="eyebrow">A love note with logistics · Jakarta</p>
        <h1 class="empty__title">Our Weekend<br />Plans</h1>
        <p class="empty__note">No plans up yet — the next one lands this Friday. 💛</p>
      </div>
    ) : (
      <>
        <section class="hero">
          <div class="hero__copy">
            <p class="eyebrow">No. {latestNo} · {latest.data.dateRange}, {latest.data.year}</p>
            <h1 class="title">{latest.data.title}</h1>
            <p class="lede">{latest.data.teaser}</p>
            <ul class="chips">
              <li class="chip">
                <Weather kind={latest.data.weather.kind} color="#332B22" size={15} />
                {latest.data.weather.label} · {latest.data.weather.hi}
              </li>
              <li class="chip">{stopCount(picks.length)}</li>
              <li class="chip">{areas.join(' · ')}</li>
            </ul>
            <div class="actions">
              <a class="btn btn--primary" href={latestHref}>
                Open the full plan <span aria-hidden="true">→</span>
              </a>
              <a class="btn btn--ghost" href="#stops">
                Jump to the stops <span aria-hidden="true">↓</span>
              </a>
            </div>
          </div>

          <a
            class="poster"
            href={latestHref}
            aria-label={`Read the full plan: ${latest.data.title}`}
            style={`background:${latestCover!.bg};color:${latestCover!.fg}`}
          >
            <span class="poster__grain" aria-hidden="true"></span>
            <span class="poster__top">
              <span>Plan No. {latestNo}</span>
              <span>{latest.data.dateRange} · {latest.data.year}</span>
            </span>
            <span class="poster__bottom">
              <span class="poster__weather">
                <Weather kind={latest.data.weather.kind} color={latestCover!.fg} size={16} />
                {latest.data.dateRange} · {latest.data.weather.hi}
              </span>
              <span class="poster__title">{latest.data.title}</span>
              <span class="poster__cue">Read the plan <span aria-hidden="true">→</span></span>
            </span>
          </a>
        </section>

        <section class="band" id="stops" aria-labelledby="stops-title">
          <div class="wrap">
            <div class="band__head">
              <h2 class="band__title" id="stops-title">This weekend’s plan</h2>
              <p class="band__hint">Each stop opens its own section</p>
            </div>

            <ol class="stops">
              {picks.map((pick) => (
                <li class="stop">
                  <a class="stop__link" href={`${latestHref}#stop-${pick.no}`}>
                    <span class="stop__no" style={`color:${areaTextColor(pick.area)}`}>{pick.no}</span>
                    <span class="stop__body">
                      <span class="stop__name">{pick.name}</span>
                      <span class="stop__meta">
                        {pick.area} · {pick.date} · {pick.budget}
                      </span>
                    </span>
                    <span class="stop__go" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ol>

            {topNotes.length > 0 && <TopThree items={topNotes} />}
          </div>
        </section>

        <section class="band" id="past" aria-labelledby="past-title">
          <div class="wrap">
            <div class="band__head">
              <h2 class="band__title" id="past-title">Past weekends</h2>
              <p class="band__hint">{all.length} weekends so far</p>
            </div>
            <ul class="archive">
              {archive.map((iss) => {
                const issAreas = uniqueAreas(iss.data.picks);
                return (
                  <li>
                    <a class="archive__row" href={withBase(`issues/${iss.id}/`)}>
                      <span class="archive__date">{iss.data.dateRange}</span>
                      <span class="archive__name">{iss.data.title}</span>
                      <span class="archive__meta">
                        {stopCount(iss.data.picks.length)}
                        {issAreas.length > 0 && ` · ${issAreas.join(' · ')}`}
                      </span>
                      <span class="archive__go" aria-hidden="true">→</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        </section>
      </>
    )}
  </main>
  <SiteFooter />
</Base>

<style>
  .home { background: var(--paper); color: var(--ink); }

  /* ─── hero ─── */
  .hero {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(26px, 4vw, 44px) clamp(20px, 5vw, 64px) clamp(28px, 4vw, 46px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .eyebrow {
    margin: 0 0 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--rust);
  }
  .title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(34px, 5.4vw, 62px);
    line-height: 0.96;
    letter-spacing: -0.02em;
  }
  .lede {
    margin: 16px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(17px, 1.7vw, 21px);
    line-height: 1.5;
    color: var(--muted);
    max-width: 46ch;
  }
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 20px 0 0;
    padding: 0;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 13px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--cream);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    color: #332b22;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 26px 0 0;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 14px 24px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, transform 0.15s;
  }
  .btn--primary { background: var(--rust); color: var(--cream); }
  .btn--primary:hover { background: #8f3318; }
  .btn--ghost { background: transparent; color: var(--ink); }
  .btn--ghost:hover { background: var(--cream); }
  .btn:active { transform: translateY(1px); }

  /* ─── cover poster ─── */
  .poster {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    min-height: 400px;
    padding: 24px 26px 26px;
    border: 1.5px solid var(--ink);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    box-shadow: 0 18px 44px rgba(34, 28, 22, 0.13);
    transition: transform 0.3s var(--ease-out);
  }
  .poster:hover { transform: translateY(-4px); }
  .poster__grain {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgba(0, 0, 0, 0.07) 1px, transparent 0);
    background-size: 13px 13px;
    pointer-events: none;
  }
  .poster__top,
  .poster__bottom { position: relative; display: flex; flex-direction: column; gap: 12px; }
  .poster__top {
    flex-direction: row;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .poster__weather {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.9;
  }
  .poster__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 2.6vw, 36px);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }
  .poster__cue {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
  }

  /* ─── bands ─── */
  .band { border-top: 1.5px solid var(--ink); }
  .wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(26px, 3.4vw, 40px) clamp(20px, 5vw, 64px) clamp(30px, 4vw, 44px);
  }
  .band__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin: 0 0 18px;
  }
  .band__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(22px, 2.8vw, 30px);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .band__hint {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ─── stops ─── */
  .stops { list-style: none; margin: 0; padding: 0; }
  .stop { border-top: 1px solid var(--rule-soft); }
  .stop:first-child { border-top: 1.5px solid var(--rule); }
  .stop:last-child { border-bottom: 1.5px solid var(--rule); }
  .stop__link {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 17px 6px;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s, padding-left 0.2s var(--ease-out);
  }
  .stop__link:hover { background: var(--cream); padding-left: 14px; }
  .stop__no {
    flex: none;
    min-width: 30px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    line-height: 1;
  }
  .stop__body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 4px; }
  .stop__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(19px, 2.1vw, 23px);
    line-height: 1.2;
  }
  .stop__meta {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .stop__go { flex: none; font-size: 20px; color: var(--rust); }

  /* ─── past weekends ─── */
  .archive { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--rule); }
  .archive li { border-bottom: 1px solid var(--rule-soft); }
  .archive__row {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 15px 6px;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: background 0.2s, padding-left 0.2s var(--ease-out);
  }
  .archive__row:hover { background: var(--cream); padding-left: 14px; }
  .archive__date {
    flex: none;
    width: 92px;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .archive__name {
    flex: 1;
    min-width: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(18px, 1.9vw, 21px);
    line-height: 1.25;
  }
  .archive__meta {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--muted);
  }
  .archive__go { font-size: 18px; color: var(--rust); }

  /* ─── empty state ─── */
  .empty {
    max-width: 1240px;
    margin: 0 auto;
    padding: clamp(70px, 16vh, 170px) clamp(20px, 5vw, 64px);
  }
  .empty__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(34px, 6vw, 68px);
    line-height: 0.92;
    letter-spacing: -0.025em;
  }
  .empty__note {
    margin: 26px 0 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(18px, 2vw, 24px);
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; padding-top: 24px; }
    .poster { display: none; }
    .actions .btn { flex: 1 1 auto; justify-content: center; }
    .archive__meta { display: none; }
  }
</style>
