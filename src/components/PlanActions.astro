---
// The plan's two whole-plan actions, shown under the header chips: one map link
// covering every stop, and the add-to-calendar .ics download. Either can be
// missing (no geocodable place, or a plan without a readable date), and the row
// disappears when both are.
interface Props {
  stops: number;
  mapUrl?: string;
  calendarHref?: string;
  /** Suggested name for the downloaded file, so it keeps its .ics extension. */
  calendarFileName?: string;
}

const { stops, mapUrl, calendarHref, calendarFileName } = Astro.props;
const mapLabel = stops === 1 ? 'Open the stop on a map' : `Map all ${stops} stops`;
---
{(mapUrl || calendarHref) && (
  <div class="actions">
    {mapUrl && (
      <a class="btn btn--primary" href={mapUrl} target="_blank" rel="noopener noreferrer">
        {mapLabel}{' '}<span aria-hidden="true">↗</span>
      </a>
    )}
    {calendarHref && (
      <a class="btn btn--ghost" href={calendarHref} download={calendarFileName}>
        Add to calendar <span aria-hidden="true">↓</span>
      </a>
    )}
  </div>
)}

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 24px 0 0;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 12px 22px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, transform 0.15s;
  }
  .btn--primary { background: var(--rust); color: var(--cream); }
  .btn--primary:hover { background: #8f3318; }
  .btn--ghost { background: transparent; color: var(--ink); }
  .btn--ghost:hover { background: var(--cream); }
  .btn:active { transform: translateY(1px); }

  @media (max-width: 700px) {
    .actions { gap: 10px; }
    .btn { flex: 1 1 auto; justify-content: center; }
  }
</style>
